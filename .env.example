# JWT Configuration
# You can generate JWT_SECRET by (Run in terminal): openssl rand -base64 32
JWT_SECRET=HmacLcBkDxhHJk5TBlgAoXqt2MnzxxYqqdcXbIQTzQQ=
# 24 Hours = 86400000 ms
# 72 Hours = 259200000 ms
JWT_EXPIRATION_MS=259200000
TEST_ADMIN_EMAIL=your_test_admin_email@gmail.com

# Environment Switch (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# Application Logging Level (INFO for production, DEBUG for full AOP traces)
LOG_LEVEL=INFO

# Prod Database
DB_URL=jdbc:postgresql://your_aws_rds_endpoint.amazonaws.com:5432/sense_aws
DB_USERNAME=postgres
DB_PASSWORD=your_prod_db_password_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_ids_comma_separated
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Firebase Admin SDK (Use ONE of the following)
# Local development: Point to the downloaded JSON file
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sensei-firebase-adminsdk.json
# Production: Provide the base64-encoded string of the JSON file
FIREBASE_CREDENTIALS_BASE64=your_base64_encoded_json_string_here

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Local Database
LOCAL_DB_URL=jdbc:mysql://localhost:3306/sensei_db
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=your_local_db_password_here

# Dozzle Logs Security
DOZZLE_USERNAME=sensei-admin
DOZZLE_PASSWORD=<password>

# Freemium Content IDs
FREEMIUM_SUBJECT_ID=your_freemium_subject_id_here
FREEMIUM_MODULE_IDS=your_freemium_module_ids_comma_separated